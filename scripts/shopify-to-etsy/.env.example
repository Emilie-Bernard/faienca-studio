# Etsy (https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://localhost:8787/callback
# Optionnel : ID numérique de la boutique si la détection automatique échoue
# ETSY_SHOP_ID=

# Shopify (Dev Dashboard / app Partner producttoetsy)
# Domaine .myshopify.com (PAS faienca.fr) — voir Paramètres → Domaines
SHOPIFY_STORE=cabxdx-vs.myshopify.com
# Option A : jeton Admin (shpat_…) si vous en avez un
# SHOPIFY_ACCESS_TOKEN=
# Option B : app Partner — ID client + secret (Paramètres de l’appli)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:3456/callback
